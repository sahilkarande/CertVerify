# Copy to backend/.env and adjust. All variables use the CERTVERIFY_ prefix.
CERTVERIFY_ENVIRONMENT=development
CERTVERIFY_DEBUG=true
CERTVERIFY_LOG_LEVEL=INFO

# Leave unset to use SQLite at backend/data/certverify.db
# CERTVERIFY_DATABASE_URL=postgresql+psycopg://certverify:certverify@localhost:5432/certverify

# CERTVERIFY_STORAGE_DIR=/absolute/path/to/storage
